# Simple Worship Presenter — example configuration
# Copy to .env and adjust for your deployment. Never commit .env.
#
# This file is loaded automatically at startup. Values already present in the
# real environment always win, so a host panel or container can override them.

# HTTP port the application listens on.
# Production deployment for app.simpleworshippresenter.com uses 3002.
PORT=3000

# Persistent data root: database and uploaded files.
# Keep this OUTSIDE the application/release directory so upgrades never
# overwrite user data. Back this directory up.
DATA_DIR=./data

# REQUIRED in production. A long random string used to sign session tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret

# development | production
NODE_ENV=development

# Set to 1 when running behind CloudPanel, nginx or another reverse proxy so
# client IP addresses and secure cookies behave correctly.
TRUST_PROXY=0

# Shown in the interface and the health endpoint.
INSTANCE_NAME=Simple Worship Presenter

# Public base URL of this instance, if any (for links and emails later).
PUBLIC_URL=

# Storage quota granted to each new account (250 MB by default).
DEFAULT_QUOTA_BYTES=262144000

# Largest single upload accepted.
MAX_UPLOAD_BYTES=262144000

# Set to 0 to stop public registration on this instance.
ALLOW_REGISTRATION=1

# debug | info | warn | error
LOG_LEVEL=info

# Rate limiting.
RATE_LIMIT_MAX_AUTH=10
RATE_LIMIT_MAX_WRITE=240

# ---------------------------------------------------------------------------
# Self-update (enabled by default)
# ---------------------------------------------------------------------------
# Simple Worship Presenter can check for and install updates from the
# administrator dashboard. Both are used on demand only: nothing is contacted
# and nothing runs until an administrator presses the button.
#
# The defaults are the official upstream release feed and a git-based install.
# Uncomment to change them, or set to an empty value to disable that part.
#
# A JSON endpoint returning { version, notes, url }. GitHub release feeds work.
#UPDATE_CHECK_URL=https://api.github.com/repos/alexanderwasson/simple-worship-presenter/releases/latest
#
# Command run by "Run update", in the application directory. Never user input.
#UPDATE_COMMAND=git pull --ff-only && npm ci --omit=dev
#
# How long an update command may run before it is abandoned.
UPDATE_TIMEOUT_MS=600000